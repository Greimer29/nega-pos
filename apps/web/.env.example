# URL base de la API (sin /api/v1 al final).
#
# DESARROLLO LOCAL (obligatorio para pnpm / npm run dev:web):
VITE_API_URL=http://localhost:3333
#
# NO uses la URL de Railway aquí. Producción se separa así:
# - Dev/tests/PR: Docker local (docker compose up -d) → :3333
# - Releases desktop/mobile: $env:VITE_API_URL="https://TU-API.up.railway.app"
#
# La web NO se despliega en Railway — corre local con pnpm dev:web

# Opcional: Google Identity Services (mismo Client ID que GOOGLE_CLIENT_ID en la API)
# VITE_GOOGLE_CLIENT_ID=
