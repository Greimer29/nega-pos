{
  "name": "mobile",
  "version": "1.3.5",
  "private": true,
  "description": "Nega POS — wrapper Capacitor Android/iOS (reutiliza web/dist)",
  "scripts": {
    "sync": "npx cap sync android",
    "sync:ios": "npx cap sync ios",
    "sync:all": "npx cap sync",
    "open": "npx cap open android",
    "open:ios": "npx cap open ios",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "build:apk:debug": "cd android && .\\gradlew.bat assembleDebug",
    "build:apk:release": "cd android && .\\gradlew.bat assembleRelease",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/barcode-scanner": "^2.2.6",
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "typescript": "^5.7.3"
  }
}
