# =============================================================================
# Nega POS API — variables for Railway (ONLY api + mysql services)
# Web, desktop and mobile run 100% LOCAL — they connect to this API URL.
# Generate APP_KEY:  cd apps/api && node ace generate:key
# Full guide:        docs/RAILWAY_DEPLOY.md
# =============================================================================

# --- Runtime ---
NODE_ENV=production
HOST=0.0.0.0
PORT=3333
TZ=UTC
LOG_LEVEL=info

# --- App (REQUIRED) ---
APP_KEY=
APP_URL=https://YOUR-API.up.railway.app

# --- Session (cross-origin: local web + desktop + Android APK) ---
SESSION_DRIVER=cookie
SESSION_MAX_AGE=365d

# --- MySQL (Railway plugin) ---
DB_HOST=${{nega-pos-mysql.MYSQLHOST}}
DB_PORT=${{nega-pos-mysql.MYSQLPORT}}
DB_USER=${{nega-pos-mysql.MYSQLUSER}}
DB_PASSWORD=${{nega-pos-mysql.MYSQLPASSWORD}}
# Plugin default DB can remain as a placeholder / admin connection target
DB_DATABASE=${{nega-pos-mysql.MYSQLDATABASE}}
# Control plane (create this DB once, or rename the plugin default to this name)
DB_CENTRAL_DATABASE=nega_pos_central
MULTI_TENANT_ENABLED=true

# --- CORS (all clients are LOCAL — do NOT deploy web on Railway) ---
FRONTEND_URL=http://localhost:5173
DESKTOP_APP_ORIGIN=http://127.0.0.1:51740
MOBILE_APP_ORIGIN=https://localhost

# --- Legacy admin seed vars (unused when MULTI_TENANT_ENABLED=true) ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NOMBRE=Administrador Nega POS

# --- Platform super admin (panel /platform) ---
PLATFORM_ADMIN_EMAIL=platform@yourdomain.com
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_PLATFORM_PASSWORD
PLATFORM_ADMIN_NAME=Platform Admin

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Persistent uploads (Volume required; files under t_<companyId>/) ---
DRIVE_DISK=local
STORAGE_LOCAL_PATH=/data/uploads

# --- Entrypoint (Railway: pre-deploy runs central+tenants; on start tenants run again as safety net) ---
RUN_MIGRATIONS_ON_START=false
# Pending company DB migrations on every boot (idempotent). Set false only if pre-deploy is verified.
RUN_TENANT_MIGRATIONS_ON_START=true
SKIP_BOOTSTRAP_SEED=false
