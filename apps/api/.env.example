# =============================================================================
# Nega POS API — local development (.env)
# For Railway production vars, copy from: .env.railway.example
# Guide: docs/RAILWAY_DEPLOY.md
# =============================================================================

# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# App (generate APP_KEY with: node ace generate:key)
APP_KEY=
APP_URL=http://localhost:3333

# Session
SESSION_DRIVER=cookie
# Inactividad máxima antes de expirar sesión (solo logout explícito en uso normal)
SESSION_MAX_AGE=365d

# MySQL (docker compose usa puerto 3306 en el host)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nega_pos
DB_PASSWORD=nega_pos
DB_DATABASE=nega_pos
DB_CENTRAL_DATABASE=nega_pos_central

# Multi-empresa: directorio central + una MySQL por empresa
MULTI_TENANT_ENABLED=true

# Tests use a separate database — see apps/api/.env.test (NODE_ENV=test)

# CORS — origen del frontend web (Vite dev)
FRONTEND_URL=http://localhost:5173
# CORS — origen de la app de escritorio Electron (servidor local embebido)
DESKTOP_APP_ORIGIN=http://127.0.0.1:51740
# CORS — origen del WebView Capacitor (APK Android)
MOBILE_APP_ORIGIN=https://localhost

# Admin user (solo seed legacy / provision overrides)
ADMIN_EMAIL=admin@negapos.local
ADMIN_PASSWORD=change-me-in-production
ADMIN_NOMBRE=Administrador Nega POS

# Super admin del panel /platform
PLATFORM_ADMIN_EMAIL=platform@negapos.local
PLATFORM_ADMIN_PASSWORD=change-me-platform
PLATFORM_ADMIN_NAME=Platform Admin

# Google Sign-In (mismo Client ID en web VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage (local disk). On Railway use Volume + STORAGE_LOCAL_PATH=/data/uploads
DRIVE_DISK=local
STORAGE_LOCAL_PATH=./storage/uploads

# Docker entrypoint (docker-compose sets RUN_MIGRATIONS_ON_START=true)
# RUN_MIGRATIONS_ON_START=false
# SKIP_BOOTSTRAP_SEED=false
