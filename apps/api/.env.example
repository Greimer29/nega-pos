# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# App (generate APP_KEY with: node ace generate:key)
APP_KEY=
APP_URL=http://localhost:3333

# Session
SESSION_DRIVER=cookie
# Inactividad máxima antes de expirar sesión (solo logout explícito en uso normal)
SESSION_MAX_AGE=365d

# MySQL (docker compose usa puerto 3306 en el host)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nega_pos
DB_PASSWORD=nega_pos
DB_DATABASE=nega_pos

# Tests use a separate database — see apps/api/.env.test (NODE_ENV=test)

# CORS — origen del frontend web (Vite dev)
FRONTEND_URL=http://localhost:5173
# CORS — origen de la app de escritorio Electron (servidor local embebido)
DESKTOP_APP_ORIGIN=http://127.0.0.1:51740

# Admin user (database/seeders/admin_user_seeder.ts)
ADMIN_EMAIL=admin@negapos.local
ADMIN_PASSWORD=change-me-in-production
ADMIN_NOMBRE=Administrador Nega POS

# Storage (local disk)
DRIVE_DISK=local
STORAGE_LOCAL_PATH=./storage/uploads