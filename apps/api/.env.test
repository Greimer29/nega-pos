# Test environment — loaded when NODE_ENV=test (see start/env.ts).
# Tests NEVER use DB_DATABASE=nega_pos (dev). See DOCUMENTACION_OFICIAL.md (sección Pruebas).

TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=test
LOG_LEVEL=warn

APP_KEY=test-app-key-must-be-at-least-32-characters-long
APP_URL=http://localhost:3333

SESSION_DRIVER=memory

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nega_pos
DB_PASSWORD=nega_pos
DB_DATABASE=nega_pos_test
DB_CENTRAL_DATABASE=nega_pos_test

# Automated tests keep legacy single-DB mode.
MULTI_TENANT_ENABLED=false

FRONTEND_URL=http://localhost:5173

ADMIN_EMAIL=admin@test.negapos.local
ADMIN_PASSWORD=test-password
ADMIN_NOMBRE=Admin Test

DRIVE_DISK=local
STORAGE_LOCAL_PATH=./storage/uploads-test
